{
  "private": true,
  "name": "swami-samarth-display",
  "description": "Kiosk app for the customer-facing payment display device",
  "version": "1.0.0",
  "author": "Sanket Nikam",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.swamisamarth.display",
    "productName": "Swami Samarth Display",
    "copyright": "Copyright © 2026 Sanket Nikam",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "pairing.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Swami Samarth Display"
    }
  }
}
